# --- Browser build config (VITE_ prefix = inlined into the bundle, never secrets) ---
# Google Analytics 4 measurement ID. Production builds read it from .env.production;
# leave it unset elsewhere and gtag.js never loads. Ignored on localhost.
VITE_GA_MEASUREMENT_ID=

# --- Server-only (Vercel Functions), never exposed to the browser ---
# Resend API key used by api/feedback.ts for the footer feedback modal.
RESEND_API_KEY=
# Where feedback lands. Defaults to ozlorienlabs@gmail.com when unset.
FEEDBACK_TO=ozlorienlabs@gmail.com
# Verified Resend sender. Defaults to Resend's shared test sender when unset.
FEEDBACK_FROM=FileKit <onboarding@resend.dev>
